<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alibaba.otter.manager.biz.statistics.throughput.dal.dataobject.ThroughputStatDO">
    <resultMap id="throughputStatResult" type="throughputStat">
        <result property="id" column="ID" />
        <result property="pipelineId" column="PIPELINE_ID" />
        <result property="startTime" column="START_TIME" />
        <result property="endTime" column="END_TIME" />
        <result property="type" column="TYPE" />
        <result property="number" column="NUMBER" />
        <result property="size" column="SIZE" />
        <result property="gmtCreate" column="GMT_CREATE" />
        <result property="gmtModified" column="GMT_MODIFIED" />
    </resultMap>
    <resultMap id="throughputStatSimpleResult" type="throughputStat">
        <result property="pipelineId" column="PIPELINE_ID" />
        <result property="type" column="TYPE" />
        <result property="number" column="NUMBER" />
        <result property="size" column="SIZE" />
    </resultMap>
    <!-- all throughputStat columns -->
    <sql id="allThroughputStatColumns">ID,PIPELINE_ID,START_TIME,END_TIME,TYPE,NUMBER,SIZE,GMT_CREATE,GMT_MODIFIED</sql>
    <!-- findThroughputStatById -->
    <select id="findThroughputStatById" resultMap="throughputStatResult" parameterType="long">
        select
        <include refid="allThroughputStatColumns" />
        from THROUGHPUT_STAT where ID = #{value}
    </select>
    <!-- listRealtimeThroughputStat -->
    <select id="listRealtimeThroughputStat" resultMap="throughputStatResult" parameterType="realtimeThroughputCondition">
        select
        <include refid="allThroughputStatColumns" />
        from THROUGHPUT_STAT
        where PIPELINE_ID=#{pipelineId} and TYPE=#{type} and  END_TIME &gt;= now() - INTERVAL #{max} MINUTE
        ORDER BY END_TIME DESC,ID DESC
    </select>
    <!-- listTimelineThroughputStat -->
    <select id="listTimelineThroughputStat" resultMap="throughputStatResult" parameterType="timelineThroughputCondition">
        select
        <include refid="allThroughputStatColumns" />
        from THROUGHPUT_STAT
        where PIPELINE_ID=#{pipelineId} and TYPE=#{type} and  END_TIME&gt;= #{start} and END_TIME &lt;= #{end}
        ORDER BY END_TIME DESC,ID DESC
    </select>
    <!-- listAllThroughputStat -->
    <select id="listAllThroughputStat" resultMap="throughputStatResult">
        select
        <include refid="allThroughputStatColumns" />
        from THROUGHPUT_STAT ORDER BY END_TIME DESC,ID DESC
    </select>
    <!-- findRealtimeThroughputStat -->
    <select id="findRealtimeThroughputStat" resultMap="throughputStatResult" parameterType="throughputCondition">
        select
        <include refid="allThroughputStatColumns" />
        from THROUGHPUT_STAT
        where PIPELINE_ID=#{pipelineId} and TYPE=#{type}
        ORDER BY END_TIME DESC,ID DESC limit 1
    </select>
    <!-- listThroughputStatByPipelineId -->
    <select id="listThroughputStatByPipelineId" resultMap="throughputStatResult" parameterType="long">
        select
        <include refid="allThroughputStatColumns" />
        from THROUGHPUT_STAT
        where PIPELINE_ID=#{pipelineId}
        ORDER BY END_TIME DESC,ID DESC
    </select>
    <update id="modifyThroughputStat" parameterType="throughputStat">
        update THROUGHPUT_STAT
        set
        PIPELINE_ID=#{pipelineId},
        START_TIME=#{startTime},
        END_TIME=#{endTime},
        TYPE=#{type},
        NUMBER=#{number},
        SIZE=#{size},
        GMT_MODIFIED=now()
        WHERE ID = #{id}
    </update>
    <insert id="insertThroughputStat" parameterType="throughputStat">
        insert into THROUGHPUT_STAT
        (PIPELINE_ID,START_TIME,END_TIME,TYPE,NUMBER,SIZE,GMT_CREATE,GMT_MODIFIED)
        values
        (#{pipelineId},#{startTime},#{endTime},#{type},#{number},#{size},now(),now())
        <selectKey keyProperty="id" resultType="long" order="AFTER">
            select last_insert_id()
        </selectKey>
    </insert>
    <delete id="deleteThroughputStat" parameterType="long">
        delete from THROUGHPUT_STAT where ID = #{value}
    </delete>
    <!-- listThroughputStatByPipelineId -->
    <select id="listRealtimeThroughputStatByPipelineIds" resultMap="throughputStatSimpleResult">
        select PIPELINE_ID, type , sum(NUMBER) as number , sum(SIZE) as size
        from THROUGHPUT_STAT
        where PIPELINE_ID in
        <foreach open="(" close=")" collection="pipelineIds" item="item" separator=",">
            #{item}
        </foreach>
        and TYPE in ('ROW','FILE') and END_TIME &gt;= (now() - INTERVAL #{minute} MINUTE)
        group by PIPELINE_ID , TYPE;
    </select>
</mapper>
