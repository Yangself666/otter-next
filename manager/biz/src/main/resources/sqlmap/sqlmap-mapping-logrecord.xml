<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alibaba.otter.manager.biz.config.record.dal.dataobject.LogRecordDO">
    <resultMap id="logRecordResult" type="logRecord">
        <result property="id" column="ID" />
        <result property="channelId" column="CHANNEL_ID" />
        <result property="pipelineId" column="PIPELINE_ID" />
        <result property="nid" column="NID" />
        <result property="title" column="TITLE" />
        <result property="message" column="MESSAGE" />
        <result property="gmtCreate" column="GMT_CREATE" />
        <result property="gmtModified" column="GMT_MODIFIED" />
    </resultMap>
    <resultMap id="logRecordWithoutMessageResult" type="logRecord">
        <result property="id" column="ID" />
        <result property="channelId" column="CHANNEL_ID" />
        <result property="pipelineId" column="PIPELINE_ID" />
        <result property="nid" column="NID" />
        <result property="title" column="TITLE" />
        <result property="gmtCreate" column="GMT_CREATE" />
        <result property="gmtModified" column="GMT_MODIFIED" />
    </resultMap>
    <!-- all columns -->
    <sql id="allLogRecordColumns">ID,CHANNEL_ID,PIPELINE_ID,NID,TITLE,MESSAGE,GMT_CREATE,GMT_MODIFIED</sql>
    <!-- all columns -->
    <sql id="allLogRecordColumnsWithoutMessage">ID,CHANNEL_ID,PIPELINE_ID,NID,TITLE,GMT_CREATE,GMT_MODIFIED</sql>
    <select id="findLogRecordById" resultMap="logRecordResult" parameterType="long">
		select
		<include refid="allLogRecordColumns" />
		from LOG_RECORD where ID = #{value}
	</select>
    <select id="getLogRecordCount" resultType="Integer">
		select count(*) from LOG_RECORD
		<trim prefix="where" prefixOverrides="AND |OR ">
            <if test="searchKey != null and searchKey != ''">
			CHANNEL_ID like concat('%',replace(#{searchKey},'_','\_'),'%')
			or PIPELINE_ID like concat('%',replace(#{searchKey},'_','\_'),'%')
			</if>
        </trim>
    </select>
    <select id="getLogRecordCountWithPIdAndSearchKey" resultType="Integer">
		select count(*) from LOG_RECORD where 1 = 1
		<trim>
            <if test="pipelineId != null">and
				PIPELINE_ID = #{pipelineId}
			</if>
            <if test="monitorName != null and monitorName != ''">and
				TITLE = #{monitorName}
			</if>
            <if test="searchKey != null and searchKey != ''">and
				MESSAGE like concat('%',replace(#{searchKey},'_','\_'),'%')
			</if>
        </trim>
    </select>
    <select id="listLogRecordsByPipelineId" resultMap="logRecordResult">
		select
		<include refid="allLogRecordColumns" />
		from LOG_RECORD where PIPELINE_ID = #{value}
		ORDER BY ID DESC
	</select>
    <select id="listLogRecordsByPipelineIdWithoutContent" resultMap="logRecordWithoutMessageResult">
		select
		<include refid="allLogRecordColumnsWithoutMessage" />
		from LOG_RECORD where PIPELINE_ID = #{value}
		ORDER BY ID DESC
	</select>
    <select id="listLogRecords" resultMap="logRecordResult">
		select
		<include refid="allLogRecordColumns" />
		from LOG_RECORD
		<trim prefix="where" prefixOverrides="AND |OR ">
            <if test="searchKey != null and searchKey != ''">
			CHANNEL_ID like concat('%',replace(#{searchKey},'_','\_'),'%')
			or PIPELINE_ID like concat('%',replace(#{searchKey},'_','\_'),'%')
			</if>
        </trim>

		ORDER BY ID DESC

		<trim>
            <if test="offset != null">
                <if test="length != null">
					limit #{offset}, #{length}
				</if>
            </if>
        </trim>
    </select>
    <select id="listLogRecordsWithCondition" resultMap="logRecordResult">
		select
		<include refid="allLogRecordColumns" />
		from LOG_RECORD where 1 = 1
		<trim>
            <if test="pipelineId != null">and
				PIPELINE_ID = #{pipelineId}
			</if>
            <if test="monitorName != null and monitorName != ''">and
				TITLE = #{monitorName}
			</if>
            <if test="searchKey != null and searchKey != ''">and
				MESSAGE like concat('%',replace(#{searchKey},'_','\_'),'%')
			</if>
        </trim>
		ORDER BY ID DESC
		<trim>
            <if test="offset != null">
                <if test="length != null">
					limit #{offset}, #{length}
				</if>
            </if>
        </trim>
    </select>
    <update id="updateLogRecord" parameterType="logRecord">
		update LOG_RECORD
		set
		CHANNEL_ID=#{channelId},
		PIPELINE_ID=#{pipelineId},
		NID=#{nid},
		TITLE=#{title},
		MESSAGE=#{message},
		GMT_MODIFIED=now()
		WHERE ID = #{id}
	</update>
    <insert id="insertLogRecord" parameterType="logRecord">
		insert into LOG_RECORD
		(CHANNEL_ID,PIPELINE_ID,NID,TITLE,MESSAGE,GMT_CREATE,GMT_MODIFIED)
		values (#{channelId},#{pipelineId},#{nid},#{title},#{message},now(),now())
	</insert>
    <delete id="deleteLogRecordById" parameterType="long">
        delete from LOG_RECORD where ID = #{value}
    </delete>
</mapper>
