<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alibaba.otter.manager.biz.config.channel.dal.dataobject.ChannelDO">
    <resultMap id="channelResult" type="channel">
        <result property="id" column="ID" />
        <result property="name" column="NAME" />
        <result property="description" column="DESCRIPTION" />
        <result property="parameters" column="PARAMETERS" />
        <result property="gmtCreate" column="GMT_CREATE" />
        <result property="gmtModified" column="GMT_MODIFIED" />
    </resultMap>
    <resultMap id="channelPkResult" type="channel">
        <result property="id" column="ID" />
    </resultMap>
    <!-- all columns -->
    <sql id="allChannelColumns">ID,NAME,DESCRIPTION,PARAMETERS,GMT_CREATE,GMT_MODIFIED</sql>
    <sql id="channelPk">ID</sql>
    <select id="listChannelPks" resultMap="channelPkResult">
		select
		<include refid="channelPk" />
		from CHANNEL
		<trim prefix="where" prefixOverrides="AND |OR ">
            <if test="searchKey != null and searchKey != ''">
			NAME like concat('%',replace(#{searchKey},'_','\_'),'%')
			or ID like concat('%',replace(#{searchKey},'_','\_'),'%')
			</if>
        </trim>

		ORDER BY ID DESC

		<trim>
            <if test="offset != null">
                <if test="length != null">
					limit #{offset}, #{length}
				</if>
            </if>
        </trim>
    </select>
    <select id="findChannelById" resultMap="channelResult" parameterType="long">
		select
		<include refid="allChannelColumns" />
		from CHANNEL where ID = #{value}
	</select>
    <select id="getChannelCount" resultType="Integer">
		select count(*) from CHANNEL
		<trim prefix="where" prefixOverrides="AND |OR ">
            <if test="searchKey != null and searchKey != ''">
			NAME like concat('%',replace(#{searchKey},'_','\_'),'%')
			or ID like concat('%',replace(#{searchKey},'_','\_'),'%')
			</if>
        </trim>
    </select>
    <select id="listChannelByIds" resultMap="channelResult">
		select
		<include refid="allChannelColumns" />
		from CHANNEL where ID in
		<foreach open="(" close=")" collection="(_parameter instanceof java.util.Map ? (_parameter.containsKey(&quot;array&quot;) ? array : list) : _parameter)" item="item" separator=",">
			#{item}
		</foreach>
		ORDER BY ID DESC
	</select>
    <select id="listChannels" resultMap="channelResult">
		select
		<include refid="allChannelColumns" />
		from CHANNEL
		<trim prefix="where" prefixOverrides="AND |OR ">
            <if test="searchKey != null and searchKey != ''">
			NAME like concat('%',replace(#{searchKey},'_','\_'),'%')
			or ID like concat('%',replace(#{searchKey},'_','\_'),'%')
			</if>
        </trim>

		ORDER BY ID DESC

		<trim>
            <if test="offset != null">
                <if test="length != null">
					limit #{offset}, #{length}
				</if>
            </if>
        </trim>
    </select>
    <update id="updateChannel" parameterType="channel">
		update CHANNEL
		set
		NAME=#{name},
		DESCRIPTION=#{description},
		PARAMETERS=#{parameters},
		GMT_MODIFIED=now()
		WHERE ID = #{id}
	</update>
    <select id="checkChannelUnique" parameterType="channel" resultType="Integer">
		select count(*) from CHANNEL
		where CHANNEL.ID != #{id}
		and CHANNEL.NAME = #{name}
	</select>
    <insert id="insertChannel" parameterType="channel">
		insert into CHANNEL
		(NAME, DESCRIPTION,PARAMETERS, GMT_CREATE, GMT_MODIFIED)
		SELECT #{name},#{description},#{parameters},now(),now()
		from dual
		WHERE not exists (select * from CHANNEL
		where CHANNEL.NAME = #{name});
		<selectKey keyProperty="id" resultType="long" order="AFTER">
			select last_insert_id()
		</selectKey>
    </insert>
    <delete id="deleteChannelById" parameterType="long">
        delete from CHANNEL where ID = #{value}
    </delete>
</mapper>
