<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alibaba.otter.manager.biz.config.pipeline.dal.dataobject.PipelineNodeRelationDO">
    <resultMap id="pipelineNodeRelationResult" type="pipelineNodeRelation">
        <result property="id" column="ID" />
        <result property="nodeId" column="NODE_ID" />
        <result property="pipelineId" column="PIPELINE_ID" />
        <result property="location" column="LOCATION" />
        <result property="gmtCreate" column="GMT_CREATE" />
        <result property="gmtModified" column="GMT_MODIFIED" />
    </resultMap>
    <!-- all pipeline columns -->
    <sql id="allPipelineNodeRelationColumns">ID,NODE_ID,PIPELINE_ID,LOCATION,GMT_CREATE,GMT_MODIFIED
	</sql>
    <select id="findPipelineNodeRelationById" resultMap="pipelineNodeRelationResult" parameterType="long">
		select
		<include refid="allPipelineNodeRelationColumns" />
		from PIPELINE_NODE_RELATION where ID = #{value}
	</select>
    <select id="getRelationCount" resultType="Integer">
		select count(*) from PIPELINE_NODE_RELATION
	</select>
    <select id="listRelationsByNodeId" resultMap="pipelineNodeRelationResult" parameterType="long">
		select
		<include refid="allPipelineNodeRelationColumns" />
		from PIPELINE_NODE_RELATION where NODE_ID = #{value} ORDER BY ID DESC
	</select>
    <select id="listRelationsByPipelineIds" resultMap="pipelineNodeRelationResult">
		select
		<include refid="allPipelineNodeRelationColumns" />
		from PIPELINE_NODE_RELATION where PIPELINE_ID in
		<foreach open="(" close=")" collection="(_parameter instanceof java.util.Map ? (_parameter.containsKey(&quot;array&quot;) ? array : list) : _parameter)" item="item" separator=",">
			#{item}
		</foreach>
		 ORDER BY ID DESC
	</select>
    <update id="updatePipelineNodeRelation" parameterType="pipelineNodeRelation">
		update PIPELINE_NODE_RELATION
		set
		NODE_ID=#{nodeId},
		PIPELINE_ID=#{pipelineId},
		LOCATION=#{location},
		GMT_MODIFIED = now()
		WHERE ID = #{id}
	</update>
    <insert id="insertPipelineNodeRelation" parameterType="pipelineNodeRelation">
		insert into PIPELINE_NODE_RELATION
		(NODE_ID, PIPELINE_ID,LOCATION,
		GMT_CREATE, GMT_MODIFIED)
		values
		(#{nodeId},#{pipelineId},#{location},now(),now())
		<selectKey keyProperty="id" resultType="long" order="AFTER">
			select
			last_insert_id()
		</selectKey>
    </insert>
    <delete id="deletePipelineNodeRelationById" parameterType="long">
        delete from PIPELINE_NODE_RELATION where ID = #{value}
    </delete>
    <delete id="deleteRelationByPipelineId" parameterType="long">
        delete from PIPELINE_NODE_RELATION where PIPELINE_ID = #{value}
    </delete>
</mapper>
