# 复制为 config/runtime.env 后按运行环境填写
# JVM 和应用参数使用 Bash 数组，含空格的参数单独加引号
JAVA_OPTS=(-Xms512m -Xmx2g -XX:+HeapDumpOnOutOfMemoryError)
APP_ARGS=()

# Node 可在这里设置节点身份和 Manager RPC 地址
# APP_ARGS=(--otter.node.id=1 --otter.manager.address=127.0.0.1:1099)

START_TIMEOUT=60
STOP_TIMEOUT=60

# 自定义日志配置未输出 Boot 启动消息时，可用健康接口确认应用就绪
# HEALTH_URL=http://127.0.0.1:8080/actuator/health
